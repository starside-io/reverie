#!/bin/sh
# Rebuilds Reverie.app after a commit that changes code the app ships.
# Runs in the background so the commit returns at once. The log is at
# .git/rebuild-app.log.

changed=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null)

# Only commits that touch what the app is built from. Docs, tests, the eval
# corpus and the skill do not change the app.
relevant=$(printf '%s\n' "$changed" \
  | grep -E '^(apps/|packages/|module\.json$|package\.json$|pnpm-lock\.yaml$|pnpm-workspace\.yaml$)' \
  | grep -vE '(\.md$|/tests/|\.test\.tsx?$)')

[ -z "$relevant" ] && exit 0

root=$(git rev-parse --show-toplevel)
git_dir=$(git rev-parse --absolute-git-dir)
nohup "$root/.githooks/rebuild-app.sh" "$root" "$git_dir" >/dev/null 2>&1 &
exit 0
