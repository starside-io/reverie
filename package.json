{
  "name": "reverie",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first memory library for one person and the assistants that work for them.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "db:check": "pnpm --filter @reverie/core db:check",
    "db:generate": "pnpm --filter @reverie/core db:generate",
    "db:migrate": "pnpm --filter @reverie/core db:migrate",
    "db:new": "pnpm --filter @reverie/core db:new",
    "desktop": "pnpm --filter @reverie/desktop app",
    "desktop:check": "pnpm --filter @reverie/desktop check",
    "pack:npm": "node scripts/pack-npm.mjs",
    "smoke:npm": "node scripts/smoke-npm.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
