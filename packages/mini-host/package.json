{
  "name": "@reverie/mini-host",
  "version": "0.0.1",
  "private": true,
  "description": "The standalone host: the ports, POST /rpc and the stdio MCP server, in one Node process that owns the SQLite file.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@reverie/connector-transcripts": "workspace:*",
    "@reverie/core": "workspace:*",
    "hono": "4.13.21",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "files": [
    "dist"
  ]
}
