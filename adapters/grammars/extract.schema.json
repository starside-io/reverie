{
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "preference",
              "procedure",
              "episode",
              "reference"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "shelf": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}\\/[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "occurredOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65,
              "pattern": "^#?[A-Za-z0-9][A-Za-z0-9-]*$"
            },
            "maxItems": 20,
            "default": []
          },
          "people": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "attendee",
                    "mentions"
                  ],
                  "default": "attendee"
                },
                "uri": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^module:\\/\\/people\\/person\\/[^\\s/]+$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "candidates": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^module:\\/\\/people\\/person\\/[^\\s/]+$"
                  },
                  "maxItems": 10,
                  "default": []
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "maxItems": 30,
            "default": []
          },
          "occasion": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "type": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z_]{1,39}$"
                  },
                  "uri": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^module:\\/\\/people\\/event\\/[^\\s/]+$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [
                  "title",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "why": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "howToApply": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          },
          "scope": {
            "type": "string",
            "enum": [
              "global",
              "project",
              "agent",
              "session"
            ],
            "default": "global"
          },
          "explicitAsk": {
            "type": "boolean",
            "default": false
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "kind",
          "title",
          "body",
          "occurredOn",
          "quote"
        ],
        "additionalProperties": false
      },
      "maxItems": 40
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "question"
        ],
        "additionalProperties": false
      },
      "maxItems": 20,
      "default": []
    }
  },
  "required": [
    "candidates"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
