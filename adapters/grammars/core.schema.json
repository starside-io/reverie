        "type": "object",
        "properties": {
          "call": {
            "type": "string",
            "pattern": "^[A-Z]{3}\\/[A-Z]{3}\\/\\d{4}-\\d{2}-\\d{2}\\/\\d{3}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "call",
          "reason"
        ],
        "additionalProperties": false
