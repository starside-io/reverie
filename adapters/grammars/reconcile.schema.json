{
  "type": "object",
  "properties": {
    "verb": {
      "type": "string",
      "enum": [
        "add",
        "refine",
        "supersede",
        "duplicate"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}\\/[A-Z]{3}\\/\\d{4}-\\d{2}-\\d{2}\\/\\d{3}$"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  },
  "required": [
    "verb",
    "reason"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
