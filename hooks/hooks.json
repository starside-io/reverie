{
  "description": "Builds a fresh plugin install in the background, adds the core block for this project at session start, asks the compaction summary to carry a reminder to save session notes, and marks a finished session as ready for extraction. Silent otherwise.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-bootstrap.mjs\" hook session-start 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-bootstrap.mjs\" hook pre-compact 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-bootstrap.mjs\" hook session-end 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
